# Telegram -> get from https://my.telegram.org (API development tools)
TG_API_ID=
TG_API_HASH=
# Channel to post into (public @name or numeric id; your userbot must be allowed to post)
TG_CHANNEL=@my_channel

# Instagram profile to mirror
IG_TARGET=

# Optional but recommended: avoids rate limits, needed for private profiles
IG_USERNAME=
IG_PASSWORD=
